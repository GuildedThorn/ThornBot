        <dependency id="Discord.Net.Core" version="3.20.1" exclude="Build,Analyzers" />
        <dependency id="Discord.Net.Rest" version="3.20.1" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.DependencyInjection.Abstractions" version="10.0.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
