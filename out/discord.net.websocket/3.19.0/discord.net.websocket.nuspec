        <dependency id="Discord.Net.Dave" version="3.19.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0">
        <dependency id="Discord.Net.Core" version="3.19.0" exclude="Build,Analyzers" />
        <dependency id="Discord.Net.Rest" version="3.19.0" exclude="Build,Analyzers" />
        <dependency id="Discord.Net.Dave" version="3.19.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net10.0">
        <dependency id="Discord.Net.Core" version="3.19.0" exclude="Build,Analyzers" />
        <dependency id="Discord.Net.Rest" version="3.19.0" exclude="Build,Analyzers" />
        <dependency id="Discord.Net.Dave" version="3.19.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>