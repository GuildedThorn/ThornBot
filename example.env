# Configure secrets + per-deployment settings. Copy to .env (never commit).
# dev/up.sh fills in the non-Token secrets automatically.

# Discord bot token. REQUIRED.
TOKEN=

# The Discord user ID that is treated as the bot owner (RequireOwner commands).
Discord__OwnerId=

# Channel ID that moderation audit entries are posted to.
Discord__AuditChannelId=

# Guild slash commands are registered to (dev guild for instant updates).
Discord__DevelopmentGuildId=887516061266755585

# Lavalink password — MUST differ from the default 'youshallnotpass'
# (SecurityValidator refuses to start otherwise). Covers config.json's
# lavalink.authorization. Keep in sync with application.yml's lavalink.server.password.
Lavalink__Authorization=

# RabbitMQ connection (GuestBookService). A dedicated user, never guest/guest.
RabbitMQ__HostName=localhost
RabbitMQ__Port=5672
RabbitMQ__UserName=thornbot
RabbitMQ__Password=
RabbitMQ__VirtualHost=/

# Where the moderation warning store lives (defaults to warnings.json in the
# working directory).
Moderation__WarnStorePath=warns.json
